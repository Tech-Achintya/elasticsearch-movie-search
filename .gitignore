# ── Dependencies ─────────────────────────────────────────────
node_modules/
.npm

# ── TypeScript build output ───────────────────────────────────
dist/
build/
*.js.map
*.d.ts

# ── Environment variables ─────────────────────────────────────
.env
.env.local
.env.*.local

# ── Logs ─────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── OS files ──────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
Thumbs.db
desktop.ini

# ── Editor / IDE ──────────────────────────────────────────────
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ── Docker volumes (local ES data) ───────────────────────────
# Elasticsearch persists data in a named Docker volume — not a
# local folder — so nothing to ignore here. But if you ever
# mount a local bind volume, add its path:
# es_data/

# ── Misc ──────────────────────────────────────────────────────
.cache/
tmp/
